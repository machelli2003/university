# Backend example environment variables
# Copy to .env and fill values for local development

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=eump_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=replace-with-a-strong-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# Paystack (test)
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Email (SMTP)
EMAIL_PROVIDER=stub
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=

# SMS (Twilio)
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# File storage (S3)
FILE_STORAGE_PROVIDER=stub
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ENDPOINT_URL=

# WAEC API
WAEC_API_ENABLED=false
WAEC_API_BASE_URL=
WAEC_API_KEY=

# CORS (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Celery
CELERY_BROKER=redis://localhost:6379/1
CELERY_BACKEND=redis://localhost:6379/2

# Environment
ENVIRONMENT=development
DEBUG=true
